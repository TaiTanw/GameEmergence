        <mxCell id="p10c8" value="IMovementSpeedModifier&#10;主动移速修饰能力 · 接口" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;" vertex="1" parent="1">
