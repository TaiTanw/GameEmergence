  <diagram id="p00" name="00 阅读导航｜先看归属，再看一帧，最后看闭环">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p00c1" value="00 阅读导航｜先看归属，再看一帧，最后看闭环" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1740" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p00c2" value="范围：当前运行时代码。重点完整展开物理执行、玩家组件调度、输入与行为；编辑器只在必要处作边注。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="50" y="86" width="1740" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p00c3" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ccd3dd;strokeColor=#ccd3dd;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="1371" width="1740" height="1" as="geometry" />
        </mxCell>
        <mxCell id="p00c4" value="GameEmergence · 2026-10-15 当前源码快照 60101a5 · 历史阅读图，不作为新设计规则" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1381" width="1600" height="27" as="geometry" />
        </mxCell>
        <mxCell id="p00c5" value="01" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1380" width="65" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p00c6" value="这份图回答什么&#10;同一次按键由谁接收？行为为什么成立？哪一步写速度？碰撞后又读什么？&#10;环境效果登记在哪？模式、控制权与轻重刷新由谁决定？" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff4df;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=20;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="1720" height="142" as="geometry" />
        </mxCell>
        <mxCell id="p00c7" value="三种图，三种读法" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="700" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p00c8" value="结构页 01—12&#10;英文类名 + 中文名称 + 职责注释&#10;看“谁持有谁、谁读谁、谁负责写”。&#10;框底给源码路径别名及当前行号。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=20;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="395" width="540" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p00c9" value="时序与调用页 13—21&#10;从上往下依次执行，箭头标实际方法。&#10;固定物理步与普通逻辑帧分开。&#10;同一时序中不假设不同Mono的订阅顺序。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=20;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="650" y="395" width="540" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p00c10" value="独立闭环页 22—25&#10;一行只解释一项需求。&#10;需求/触发 → 输入/规则 → 功能 → 结果。&#10;多行互相隔开，方便按问题查代码。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d0ece7;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=20;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1240" y="395" width="540" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p00c11" value="图例与关键限制" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="635" width="700" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p00c12" value="实线开箭头：调用/接线方向；黑菱形起端：持有或组合。&#10;空心三角指向父类；虚线空心三角指向实现的接口。虚线开箭头：只读依赖。&#10;蓝：玩家逻辑；绿：物理执行；青：环境能力；黄：数据/只读快照；紫：规则；灰：外围系统入口。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=19;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="687" width="1720" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p00c13" value="读图时牢记&#10;① Player、CharacterPhysics、PresentationLayer 是同一角色上的不同职责，不是继承关系。&#10;② Update 和 FixedUpdate 没有一一对应：事件先锁存，下一可用固定步消费。&#10;③ 刚体实际速度是跨帧运动依据；命令、来源参数和表现数据不是三份累计动量。&#10;④ 暂停、传送、试验重置、失败重开具有不同边界，不能用“刷新一下”混称。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff4df;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=19;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="860" width="1720" height="208" as="geometry" />
        </mxCell>
        <mxCell id="p00c14" value="路径别名（相对仓库根目录）" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1110" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p00c15" value="P = Assets/Script/Framworker/Function/Player/&#10;PH = Assets/Script/Framworker/Function/Physics/&#10;S = Assets/Script/Framworker/AOTSystem/Mgr/Scheduling/&#10;A = Assets/Script/Framworker/AOTSystem/&#10;V = Assets/Script/Framworker/Function/Performance/Component/&#10;U = Assets/Script/Framworker/UISystem/&#10;T = Assets/Script/Task/gameOBJ/&#10;D = Assets/Script/Data/" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="1156" width="1720" height="175" as="geometry" />
        </mxCell>
        <UserObject id="p00c16" label="返回可点击目录" link="data:page/id,p40">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1510" y="1381" width="170" height="25" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
