          <mxGeometry x="1240" y="165" width="540" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p01c18" value="InputControlMgr&#10;唯一玩家输入与控制目标管理器 · 类" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1256" y="174" width="508" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p01c19" value="职责：读取动作资产，持有一份输入数据和一个当前 Player；不判断着地或&#10;积分速度。&#10;BindInputAsset()：订阅六项动作&#10;BindPlayer()：撤旧输入，再绑定新目标&#10;InputOpenOrClose() / SyncHeldInputs()&#10;Update()：交互计时、回车、ESC和镜头" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1">
