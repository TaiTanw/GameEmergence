        <mxCell id="p06c28" value="FourWayMovementState&#10;四向移动共用行为 · 类" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;" vertex="1" parent="1">
