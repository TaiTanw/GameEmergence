        </mxCell>
        <mxCell id="p10c29" value="职责：平台先移动，脚下实体再把本步位移除固定步长并入速度一次。&#10;Delta：世界位移，不是速度" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1">
