        <mxCell id="p14c1" value="12 交互与关卡规则｜谁能请求，谁提交自己的状态" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1740" height="45" as="geometry" />
