        <mxCell id="p10c23" value="IGroundResponse&#10;脚下表面响应能力 · 接口" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="76" y="559" width="508" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p10c24" value="职责：只有当前脚下来源提供；区域重叠不会凭空变成支撑。&#10;SlowingEffect：消退阻力倍率&#10;JumpHeightNum：起跳速度加成" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1">
