  <diagram id="p33" name="29 源码阅读索引与术语｜回到代码定位细节">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p33c1" value="29 源码阅读索引与术语｜回到代码定位细节" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1740" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p33c2" value="本图依据当前源码而非历史图推演；不改游戏代码，不把图中说明补成新的运行框架。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="50" y="86" width="1740" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p33c3" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ccd3dd;strokeColor=#ccd3dd;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="1371" width="1740" height="1" as="geometry" />
        </mxCell>
        <mxCell id="p33c4" value="GameEmergence · 2026-10-15 当前源码快照 60101a5 · 历史阅读图，不作为新设计规则" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1381" width="1600" height="27" as="geometry" />
        </mxCell>
        <mxCell id="p33c5" value="34" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1380" width="65" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p33c6" value="按问题找入口&#10;输入/改键/控制目标 → P/Mgr/InputControlMgr.cs&#10;每帧玩家组装与操作 → P/Player.cs → P/FSM/PlayerStateMachine.cs&#10;地面/空中/墙滑 → P/FSM/BehavioralState.cs；水面/四向 → 同目录两个State文件&#10;固定时序 → S/MonoPublicMgr.cs；运动合成 → PH/Component/PlayerOBJ/base/BasicEntity.cs&#10;角色探针/单向平台 → PH/Component/PlayerOBJ/base/BasePhysicsEntity.cs&#10;普通跳/墙跳/四向/形态/推拉 → PH/Component/PlayerOBJ/CharacterPhysics.cs" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="1720" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p33c7" value="环境与交互&#10;来源关系 → PH/Base/EntityEnvironmentContext.cs → EnvironmentRegistration.cs&#10;参数合成 → PH/Data/EntityEffectState.cs；能力解析 → PH/Data/EntityEnvironmentFrame.cs&#10;源宿主/提交 → PH/Component/SceneObjects/Base/BasicPhysicalObject.cs&#10;性质/计算点 → PH/Data/EnvironmentParameter.cs；P/CognitionBackpack.cs&#10;侧推 → PH/Base/EntitySidePush.cs；选箱 → P/PlayerBoxSelection.cs → PhysicalBox.cs&#10;小车/压感/机关台阶 → PH/Component/SceneObjects/ 下同名文件" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d0ece7;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="465" width="1720" height="240" as="geometry" />
        </mxCell>
        <mxCell id="p33c8" value="规则与接入&#10;模式、死亡、认知、轻刷新 → P/PlayerLifecycleRules.cs&#10;场景组装与失败 → S/SceneChangeMgr.cs；逃生两页 → SceneChangeMgr.EscapePreparation.cs&#10;退场交接 → SceneChangeMgr.EscapeHandoff.cs；普通跨关 → SceneChangeMgr.LevelClear.cs&#10;效果 → P/PlayerEffectLedger.cs / PlayerAbilityPool.cs；范围 → PlayerAttributeRange.cs&#10;表现 → V/PresentationLayer.cs 及同名前缀partial文件；运行UI → U/UIobject/&#10;编辑器仅边注：物理观测桥只复制事实；环境/费用制作窗口只负责制作数据。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="745" width="1720" height="242" as="geometry" />
        </mxCell>
        <mxCell id="p33c9" value="术语与阅读限制&#10;“逻辑帧”= Player.Update/TickLogic；“固定步”= MonoPublicMgr.FixedUpdate统一模拟。&#10;“几何事实”= 碰撞体/法线/重叠；“能力”= 接口及有效配置；“许可”= 阶段规则授予的资格。&#10;“本步命令”= submitted/planned velocity；“实际结果”= 模拟后的rb.position/velocity。&#10;历史EscapePenaltyOffer等兼容类型不是P20主链；自动负面现在来自PlayerAbilityPool。&#10;图中类框列的是理解本主题所需关键字段/方法，不是穷举所有私有缓存、调试和编辑器成员。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff4df;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="1027" width="1720" height="260" as="geometry" />
        </mxCell>
        <UserObject id="p33c10" label="返回可点击目录" link="data:page/id,p40">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1510" y="1381" width="170" height="25" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
