        </mxCell>
        <mxCell id="p20c2" value="同一精神体在漫游/模拟间切换；不是重新生成玩家。水面/淹没由查询决定，不由方向键写入。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;" vertex="1" parent="1">
