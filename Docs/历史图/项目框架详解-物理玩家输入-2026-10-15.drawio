        <mxCell id="p13c18" value="EnvironmentEditDraft&#10;环境与背包联合编辑草稿 · 类" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;" vertex="1" parent="1">
