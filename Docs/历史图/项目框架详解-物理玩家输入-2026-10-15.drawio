          <mxGeometry x="75" y="1029" width="450" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p36c88" value="持续附加速度能力" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1">
