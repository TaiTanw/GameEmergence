        <mxCell id="p15c51" value="17  相位6：保留槽；没有第二次模拟" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=#ffffff;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1">
