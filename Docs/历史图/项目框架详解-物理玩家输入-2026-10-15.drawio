        <mxCell id="p01c26" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
