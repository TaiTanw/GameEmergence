        <mxCell id="p17c3" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ccd3dd;strokeColor=#ccd3dd;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="1371" width="1740" height="1" as="geometry" />
        </mxCell>
        <mxCell id="p17c4" value="GameEmergence · 2026-10-15 当前源码快照 60101a5 · 历史阅读图，不作为新设计规则" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1381" width="1600" height="27" as="geometry" />
        </mxCell>
        <mxCell id="p17c5" value="18" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1380" width="65" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p17c6" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="540" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p17c7" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d0ece7;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="540" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p17c8" value="EntityEffectState&#10;实体的环境参数与限时命令容器 · 类" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="76" y="174" width="508" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p17c9" value="职责：持有来源键对应的移速、流速、动态施力参数；真正惯性仍在刚体。&#10;UpdateMovementModifier()：求和限幅&#10;UpdatePassiveSpeed()：状态/限时速度&#10;CalculateDynamicVelocityDelta()：本步增量&#10;RemoveDynamicForce()：退出不清实际惯性" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="76" y="242" width="508" height="185" as="geometry" />
        </mxCell>
        <mxCell id="p17c10" value="PH/Data/EntityEffectState.cs:6" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#64748b;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="76" y="429" width="508" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p17c11" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="650" y="165" width="540" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p17c12" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="650" y="165" width="540" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p17c13" value="ForceData&#10;实体中的动态施力控制参数 · 结构体" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="666" y="174" width="508" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p17c14" value="职责：每个动态来源对应一份参数与施力类型；不储存另一份累计速度。&#10;parameters：DynamicForceParameters&#10;type：apply施力 / controlRecovery制动&#10;Force / recoverySpeed / balanceSpeed" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="666" y="242" width="508" height="185" as="geometry" />
        </mxCell>
        <mxCell id="p17c15" value="PH/Data/Struct.cs:51" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#64748b;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="666" y="429" width="508" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p17c16" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
