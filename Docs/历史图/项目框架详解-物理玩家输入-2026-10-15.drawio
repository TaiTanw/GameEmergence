        </mxCell>
        <mxCell id="p10c19" value="职责：首次接入按受力者生成参数，后续沿动态施力回调改变本步控制。&#10;CreateEnvironmentForce(receiver)&#10;继承 IDynamicAddForce" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1">
