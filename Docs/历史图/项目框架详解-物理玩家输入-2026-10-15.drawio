        <mxCell id="p15c49" value="16  同相位5：Player.CheckMechanismCrush()" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=#ffffff;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1">
