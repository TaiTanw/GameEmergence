          <mxGeometry x="980" y="975" width="780" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p36c85" value="修饰的是主动移动倍率，与额外流速、动态加速度各自分开。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#52647a;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
