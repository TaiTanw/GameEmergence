  <diagram id="p16" name="14 一次速度合成｜从实际刚体速度到命令，再回读">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p16c1" value="14 一次速度合成｜从实际刚体速度到命令，再回读" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1740" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p16c2" value="本页节点是方法内步骤，不是新增类。主线对应BasicEntity.SpeedCalculation，蓝/黄分量只为避免重复合成。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="50" y="86" width="1740" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p16c3" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ccd3dd;strokeColor=#ccd3dd;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="1371" width="1740" height="1" as="geometry" />
        </mxCell>
        <mxCell id="p16c4" value="GameEmergence · 2026-10-15 当前源码快照 60101a5 · 历史阅读图，不作为新设计规则" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1381" width="1600" height="27" as="geometry" />
        </mxCell>
        <mxCell id="p16c5" value="17" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1380" width="65" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p16c6" value="1 许可与模式分支&#10;&#10;SynchronizeMotionParticipation()&#10;未参与：结束；Kinematic待机：清本步命令。&#10;飞行：直接使用CollisionFreeVelocity，仍交统一模拟。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="175" width="540" height="265" as="geometry" />
        </mxCell>
        <mxCell id="p16c7" value="2 以上一步真实速度为基准&#10;&#10;actual = rb.velocity&#10;free = actual - acceptedPrescribedVelocity&#10;有主动驱动再减上步实际接受的主动X。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="650" y="175" width="540" height="265" as="geometry" />
        </mxCell>
        <mxCell id="p16c8" value="3 更新本步环境参数&#10;&#10;UpdateMovementModifier()：修饰求和并限幅&#10;UpdatePassiveSpeed()：状态速度与限时命令&#10;CalculateDynamicVelocityDelta()：算本步速度变化。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1240" y="175" width="540" height="265" as="geometry" />
        </mxCell>
        <mxCell id="p16c9" value="4 合成水平运动&#10;&#10;无动态环境时，对真实被动惯性按阻力制动。&#10;HActiveSpeedOperation()计算主动目标并消费事件。&#10;MoveTowards主动X；合入被动X，准备下坡贴合。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1240" y="530" width="540" height="265" as="geometry" />
        </mxCell>
        <mxCell id="p16c10" value="5 唯一重力与竖直行为&#10;&#10;VUnderForce()：空中积分重力；地面清向下速度。&#10;VActiveSpeedOperation() → VerticalTransmission()&#10;处理水面悬浮、四向竖直或墙滑下限。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="650" y="530" width="540" height="265" as="geometry" />
        </mxCell>
        <mxCell id="p16c11" value="6 合入规定运动并裁地形&#10;&#10;own + 状态/限时速度 + platformDelta/dt + 下坡项&#10;ClipStaticTerrain()收静墙、可爬坡面、头顶。&#10;plannedVelocity = submittedVelocity。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="540" height="265" as="geometry" />
        </mxCell>
        <mxCell id="p16c12" value="7 写入并模拟&#10;&#10;rb.velocity = submittedVelocity；Report(this)&#10;相位4只写第一只侧面实体水平速度。&#10;随后公共Physics2D.Simulate一次处理实体碰撞。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="885" width="540" height="265" as="geometry" />
        </mxCell>
        <mxCell id="p16c13" value="8 只回读实际接受量&#10;&#10;DisplacementCorrection()：actual = rb.velocity&#10;AcceptedComponent按实际结果拆分本步贡献。&#10;写只读速度/位移观测；此处不再迁移位置。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="650" y="885" width="540" height="265" as="geometry" />
        </mxCell>
        <mxCell id="p16c14" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=1.7;strokeColor=#3f5875;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="307" as="sourcePoint" />
            <mxPoint x="650" y="307" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p16c15" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=1.7;strokeColor=#3f5875;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1190" y="307" as="sourcePoint" />
            <mxPoint x="1240" y="307" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p16c16" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=1.7;strokeColor=#3f5875;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1510" y="440" as="sourcePoint" />
            <mxPoint x="1510" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p16c17" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=1.7;strokeColor=#3f5875;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="662" as="sourcePoint" />
            <mxPoint x="1190" y="662" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p16c18" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=1.7;strokeColor=#3f5875;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="662" as="sourcePoint" />
            <mxPoint x="600" y="662" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p16c19" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=1.7;strokeColor=#3f5875;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="795" as="sourcePoint" />
            <mxPoint x="330" y="885" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p16c20" value="" style="edgeStyle=none;rounded=0;html=0;strokeWidth=1.7;strokeColor=#3f5875;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="1017" as="sourcePoint" />
            <mxPoint x="650" y="1017" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p16c21" value="三个易混点&#10;• 平台给Delta，除dt后只加入一次。&#10;• 源退出撤参数，不抹掉已获得的实际惯性。&#10;• 墙跳当前仍读取基础upSpeed/speed，&#10;  普通跳读取EffectiveJumpSpeed。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff4df;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1240" y="885" width="540" height="265" as="geometry" />
        </mxCell>
        <mxCell id="p16c22" value="同一速度不能同时保存在源端“尾效”、效果容器“累计量”和刚体中。字段名沿用现码；不要把本页误当成新运动设计。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff4df;strokeColor=#e0bc7b;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;spacing=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="60" y="1325" width="1720" height="42" as="geometry" />
        </mxCell>
        <UserObject id="p16c23" label="返回可点击目录" link="data:page/id,p40">
          <mxCell style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1510" y="1381" width="170" height="25" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p17" name="14B 速度参数与侧推数据｜哪些是参数，哪些只是本步事实">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p17c1" value="14B 速度参数与侧推数据｜哪些是参数，哪些只是本步事实" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1740" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p17c2" value="补充速度合成中的实际数据类型；侧推记录在相位4消费后清空，不建立下一帧的传力缓存。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="50" y="86" width="1740" height="54" as="geometry" />
