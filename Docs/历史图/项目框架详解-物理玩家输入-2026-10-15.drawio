        <mxCell id="p10c33" value="IWallSlideSurface&#10;墙滑表面能力 · 接口" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1256" y="559" width="508" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p10c34" value="职责：几何命中之后再判断是否存在有效能力；普通墙仍能阻挡。&#10;WallSlideMultiplier：下滑限速倍率" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1">
