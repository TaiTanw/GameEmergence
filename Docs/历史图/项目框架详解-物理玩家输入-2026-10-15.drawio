        <mxCell id="p34c17" value="LevelStageMgr" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;" vertex="1" parent="1">
