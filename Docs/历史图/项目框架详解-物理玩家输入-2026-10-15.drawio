        </mxCell>
        <mxCell id="p10c14" value="职责：按来源求和，每步合成一次；例如水流。不是每步再累加的加速度。&#10;StateVelocity：二维速度" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1">
