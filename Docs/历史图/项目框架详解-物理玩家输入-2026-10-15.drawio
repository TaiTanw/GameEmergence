          <mxGeometry x="980" y="1029" width="780" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p36c90" value="按来源求和，每步合成一次；例如水流。不是每步再累加的加速度。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#52647a;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
