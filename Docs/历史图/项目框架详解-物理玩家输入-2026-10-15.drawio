        </mxCell>
        <mxCell id="p36c95" value="首次接入按受力者生成参数，后续沿动态施力回调改变本步控制。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#52647a;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
