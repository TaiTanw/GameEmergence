        <mxCell id="p01c27" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#60758c;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="650" y="550" width="540" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p01c28" value="Player&#10;玩家组件组装与操作宿主 · 类" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="666" y="559" width="508" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p01c29" value="职责：把输入、状态机、物理和表现接在一起；维护选中关系并向规则请求&#10;死亡/转换。&#10;Awake() / EnsureRuntimeReady()：接线&#10;TickLogic()：交互→行为→提示→氧气&#10;ApplyCapabilities()：提交规则许可&#10;RefreshRuntime() / TeleportRuntime()" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=#23354a;fontFamily=Microsoft YaHei;fontSize=15;" vertex="1" parent="1">
