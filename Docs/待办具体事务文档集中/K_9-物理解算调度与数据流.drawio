        <mxCell id="scheduler" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;谁真正驱动相位？&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;MonoPublicMgr.FixedUpdate：先执行 FixedUpdateEvent，再按 actionsLen 的索引顺序调用。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;实体启用时登记相位 1 / 2 / 3 / 5；Solver.Init 登记相位 4；平台登记相位 0。槽 6 保留。&lt;/div&gt;&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F7F9FC;strokeColor=#B5BFCD;strokeWidth=1.5;">
          <mxGeometry x="40" y="490" width="2420" height="145" as="geometry" />
        </mxCell>
