          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="force" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4.5 · 应用受阻清理与有向力&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;先调用 ClearTransientSpeedForFinalBlock。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;再调用 ApplyPendingContactForces；不回写本帧请求。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · ApplyContactEffectsAfterFinalRequests">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
