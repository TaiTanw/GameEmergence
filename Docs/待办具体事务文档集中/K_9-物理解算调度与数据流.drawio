  <diagram id="phase4-data" name="02 · 数据流、读写阶段与结构语义">
    <mxGraphModel dx="2389" dy="1231" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="3290" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F7F9FC;strokeColor=#B5BFCD;strokeWidth=1.5;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:30px&quot;&gt;02 · 数据流、读写阶段与结构语义&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;2026-10-03 · K9 运动/请求/实际结果、两处策略与 Unity 读写端 · 以当前代码为准&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="2420" x="40" y="25" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F7F9FC;strokeColor=#B5BFCD;strokeWidth=1.5;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;读图约定&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;箭头表示数据被谁读取或写入；不是又一条物理调度顺序。方法调用顺序见第一页。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;四类核心数据仍分基础运动、预测、候选查询与请求；接触策略、请求策略和青色 Unity 读写端是三处不同入口。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="2420" x="40" y="160" as="geometry" />
        </mxCell>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;相位 1 · GeometryPhysicsData&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;子类接触查询经 PhysicsWorld；区域 Trigger 经 OverlapCollider。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;当前支撑、左右墙、顶面、法线、区域 Trigger。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;读：相位 2 能力解析、相位 3 支撑处理、相位 4 筛选。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;语义：帧初几何事实；相位 4 候选查询不回写它。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Data/Struct.cs" tooltip="Assets/Script/Framworker/Function/Physics/Data/Struct.cs · GeometryPhysicsData" id="geometry">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF4DF;strokeColor=#B99142;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="245" width="740" x="40" y="350" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;相位 2 · Context / EnvironmentFrame&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;PhyFunUpdate → RefreshEnvironment：维护来源关系并采样脚下参数。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;EntityEnvironmentFrame：阻力倍率、跳跃加成、平台 Delta。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;平台 Delta 来自相位 0；相位 3 接地时并入 motionFrame。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;关系归 Context；参数快照不保存累计速度。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Data/EntityEnvironmentFrame.cs" tooltip="Assets/Script/Framworker/Function/Physics/Data/EntityEnvironmentFrame.cs · EntityEnvironmentFrame" id="environment">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF4DF;strokeColor=#B99142;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="245" width="740" x="840" y="350" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;相位 3 · PlayerPhysicsData / EffectState&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;SpeedCalculation 先更新水平效果与主动操作，再处理垂直运动。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;PlayerPhysicsData 是跨帧运动状态；verticalSpeed 包含重力 / 跳跃。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;EffectState 汇总限时、持续、动态速度；上一帧接触力在这里积分。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;PhysicalFunctionData 的墙滑能力由相位 2 解析。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Data/Struct.cs" tooltip="Assets/Script/Framworker/Function/Physics/Data/Struct.cs · PlayerPhysicsData" id="movement">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF4DF;strokeColor=#B99142;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="245" width="820" x="1640" y="350" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge-1" edge="1" parent="1" source="geometry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="environment" value="解析">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" edge="1" parent="1" source="environment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="movement" value="消费">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;相位 3 输出 · EntityMotionFrame&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;实体 BuildMotionFrame 整体生成 readonly struct。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;freeVelocity：支撑处理前的自由合速度。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;motionVelocity / motionDelta：支撑处理后的自身运动。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;platformDelta：独立平台携带；plannedWorldDelta：自身加平台。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;相位 4 只读；施力读自身速度，坡面保留率读原自身位移。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;不含接触纠偏、环境裁剪、最终请求或实际落点。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Data/Struct.cs" tooltip="Assets/Script/Framworker/Function/Physics/Data/Struct.cs · EntityMotionFrame" id="motion">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF4DF;strokeColor=#B99142;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="325" width="740" x="40" y="710" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;相位 3 上报 · PhysicalBoundingBox&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;PositionPrediction 经 PhysicsWorld.ReadAabb 读取当前 Collider。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;point：Collider 中心按 plannedWorldDelta 平移后的预测中心。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;size：半宽 / 半高；motionFrame：同帧运动副本；myPhyBox：写回实体入口。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Solver.AddPhyBoX 上报；相位 4 冻结读取，轮内不改预测快照。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;请求终点由该预测中心还原起点，再加 RequestedWorldDelta。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;相位 4 末管理器清空列表；下帧重新上报。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Data/Struct.cs" tooltip="Assets/Script/Framworker/Function/Physics/Data/Struct.cs · PhysicalBoundingBox" id="prediction">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF4DF;strokeColor=#B99142;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="325" width="740" x="840" y="710" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;相位 3 先重置 · EntitySolutionResult&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;PositionPrediction：接触偏置、环境偏置、阻挡方向归零。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;请求位移先设为 plannedWorldDelta。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;allowedHorizontalDelta 在随后每次 Probe 中初始化。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;可变 struct，由实体持有；相位 4 反复更新。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;不是运动快照，也不是跨帧速度容器。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Data/Struct.cs" tooltip="Assets/Script/Framworker/Function/Physics/Data/Struct.cs · EntitySolutionResult" id="seed">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF0E9;strokeColor=#C47B57;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="325" width="820" x="1640" y="710" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge-3" edge="1" parent="1" source="movement" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="motion" value="构建基础运动">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1763" y="650" />
              <mxPoint x="410" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-4" edge="1" parent="1" source="motion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="prediction" value="复制">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4.1 · 管理器调用接触策略&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;ContactStrategy = CurrentAabbContactSolver，窄口是 IContactSolveStrategy。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;PlanInitialOffsets 读取冻结 PhysicalBoundingBox 列表，输出 EntityOffsetDecision。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;管理器 ApplyPendingOffsets 逐项调用实体写口。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;策略算 AABB 分离；管理器仍持有相位顺序与结果应用。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/CurrentAabbContactSolver.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/CurrentAabbContactSolver.cs · PlanInitialOffsets" id="first">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="240" width="740" x="40" y="1150" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;结果变化① · displacementOffset&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;策略输出 EntityOffsetDecision；管理器逐项调用实体累加偏置。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;首轮可能包含 X / Y；后续水平反馈只增加 X。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;每次 Probe 保留该累计值，不在反馈轮间清零。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;语义：本帧实体间分离量；不是平台携带、主动运动或推箱状态。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Data/Struct.cs" tooltip="Assets/Script/Framworker/Function/Physics/Data/Struct.cs · EntitySolutionResult" id="offset">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF0E9;strokeColor=#C47B57;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="240" width="820" x="1640" y="1150" as="geometry" />
          </mxCell>
        </object>
        <object id="world-access" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;K9.4 · IPhysicsWorldAccess2D&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;BasicEntity.PhysicsWorld 默认取 UnityPhysicsWorldAccess2D.Instance。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;BasicEntity、BasePhysicsEntity、PhysicalBox 的环境查询使用此 Unity 端口。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;ReadAabb / BoxCast / OverlapBox / OverlapCollider 等查询；ReadBodyPosition / SubmitPosition 管位置。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Collider2D、Rigidbody2D、RaycastHit2D、Bounds 仍是 Unity 类型。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;这里不决定接触纠偏或效果；相位 4 的解算策略入口独立。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Interface/IPhysicsWorldAccess2D.cs" tooltip="Assets/Script/Framworker/Function/Physics/Interface/IPhysicsWorldAccess2D.cs · IPhysicsWorldAccess2D">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E6F5F4;strokeColor=#4B9292;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="240" width="740" x="840" y="1150" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge-5" edge="1" parent="1" source="first" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="offset" value="调用实体累计">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="825" y="1270" />
              <mxPoint x="825" y="1130" />
              <mxPoint x="1610" y="1130" />
              <mxPoint x="1610" y="1270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-6" edge="1" parent="1" source="prediction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" target="first" value="冻结预测输入">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="988" y="1100" />
              <mxPoint x="805" y="1100" />
              <mxPoint x="805" y="1198" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4.2 / 反馈轮末 · 管理器调用实体&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;ResolveEnvironmentRequests 逐实体调用 ProbeCandidateEnvironment，再调 FinalizeRequestedDisplacement。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;BasicEntity 经 PhysicsWorld 填工作区，随后调用 IEntityRequestSolveStrategy。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;默认 CurrentEntityRequestSolver.ResolveCandidate / FinalizeRequest。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;管理器只管首轮及反馈轮复用，不直接改 Unity 命中列表。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · ResolveEnvironmentRequests" id="probe-stage">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="255" width="740" x="40" y="1510" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;查询工作区 · EntityCandidateGeometry&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;实体持有的可复用 class；每次 Probe 经 PhysicsWorld 查询后重填。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;candidateCenter / candidateDelta：基础预测叠加当前实体纠偏。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;pathHits：整段候选路径；endpointOverlaps：候选终点重叠。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;downwardHits：候选脚下；allowedDownwardHits：X 受限后脚下。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;liftHits：额外抬升净空；downwardCastLift：回扫起点高度。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;oneWayEffectors：组件身份缓存，通行仍按本次运动判断。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;不替换帧初 GeometryPhysicsData，也不保存最终请求。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Data/Struct.cs" tooltip="Assets/Script/Framworker/Function/Physics/Data/Struct.cs · EntityCandidateGeometry" id="candidate">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF4DF;strokeColor=#B99142;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="360" width="740" x="840" y="1480" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;结果变化② · 环境约束&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;BasicEntity.Probe 重置 environmentOffset，初始化 allowedHorizontalDelta。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;CurrentEntityRequestSolver.ResolveCandidate 读 EntityEnvironmentSolveInput 与候选命中。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;策略写允许 X、额外坡面 Y；X 受限后可经 world 重新查询脚下。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;FindSlopeRise、HasLiftObstacle、单向通行是该策略私有算法。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;不会改 displacementOffset；候选命中不等于最终环境约束。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/CurrentEntityRequestSolver.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/CurrentEntityRequestSolver.cs · ResolveCandidate" id="constraints">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF0E9;strokeColor=#C47B57;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="285" width="820" x="1640" y="1510" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge-7" edge="1" parent="1" source="probe-stage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="candidate" value="实体更新工作区">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-17" edge="1" parent="1" source="world-access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B9292;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="candidate" value="Unity 命中">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-18" edge="1" parent="1" source="probe-stage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B9292;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;dashed=1;" target="world-access" value="查询端">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="1548" />
              <mxPoint x="810" y="1342" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-8" edge="1" parent="1" source="candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="constraints" value="约束">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-9" edge="1" parent="1" source="offset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" target="candidate" value="候选叠加累计偏置">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1763" y="1430" />
              <mxPoint x="1506" y="1430" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4.3 · 管理器反馈轮&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;以 ContactStrategy.MaxFeedbackPasses 控制轮数，当前策略为两轮。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;CurrentAabbContactSolver.PlanResidualOffsets 读最终请求与冻结预测，输出 X 偏置决定。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;管理器有决定才应用并统一复用 4.2；无决定提前结束。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;同轮不立即刷新每对接触的请求；不保证任意箱链收敛。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · ResolveResidualHorizontalOverlaps" id="feedback">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="245" width="740" x="40" y="1930" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="cache-lifetime" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F7F9FC;strokeColor=#B5BFCD;strokeWidth=1.5;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;重复求解时哪些变化？&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;保持：motionFrame 与 PhysicalBoundingBox 的基础快照。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;累计：displacementOffset，只在下帧相位 3 重置。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;重建：CandidateGeometry 命中列表与候选位置。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;重算：环境允许 X、额外 Y、请求位移与阻挡方向。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;不变：Unity 世界位置和帧初几何事实。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="740" x="840" y="1930" as="geometry" />
        </mxCell>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;结果变化③ · 最终请求与阻挡方向&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;BasicEntity.FinalizeRequestedDisplacement 调策略 FinalizeRequest。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;CurrentEntityRequestSolver 合成允许 X、坡面 Y、独立垂直、平台与接触 Y。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;复用候选路径裁剪顶面，写 requestedWorldDelta 和 blockedHorizontalDirection。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;它仍只是每轮请求；相位 5 消费最后一版，引擎实际落点下一帧才读。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;阻挡方向由请求缩短判定，不是实际碰撞反馈。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/CurrentEntityRequestSolver.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/CurrentEntityRequestSolver.cs · FinalizeRequest" id="request">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF0E9;strokeColor=#C47B57;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="270" width="820" x="1640" y="1930" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge-10" edge="1" parent="1" source="constraints" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="request" value="合成完整请求">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-11" edge="1" parent="1" source="request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="feedback" value="读当前请求 / 阻挡">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2050" y="2240" />
              <mxPoint x="410" y="2240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-12" edge="1" parent="1" source="feedback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C47B57;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="probe-stage" value="重查">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="15" y="2052" />
              <mxPoint x="15" y="1637" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4.4–4.7 · 当帧接触效果决定&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;ContactForceLink 是有向来源键，A→B 与 B→A 不同。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;previous 跨帧保存；current 本帧重建，应用退出后交换。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;pendingContactForces：来源关系＋力参数；不持有接收者累计速度。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;pendingAttenuations：实体＋方向 → 最小保留率，仅新关系汇总。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;pendingExitedContactLinks：失效旧来源；同相位 4 决定并应用，下帧相位 3 积分。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · ContactForceLink" id="relations">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F2EDFA;strokeColor=#9775BB;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="315" width="740" x="40" y="2350" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;实体跨帧状态 · EntityEffectState&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;管理器调用实体入口，由实体转交自己的效果容器。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;SetOrUpdateDynamicForce：刷新参数 / apply，保留旧累计速度。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;ClearTransientSpeedForFinalBlock：满足净被动受阻条件时整体清累计。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;AttenuateTransientContactSpeed：新接触一次性消耗限时 / fadeAway 速度。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;旧来源退出：ClearBlockedContactSpeed 后 RemoveForce 切 fadeAway。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;相位 4 修改容器；冻结快照 / 当前请求不重算。下帧相位 3 汇总速度。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Data/EntityEffectState.cs" tooltip="Assets/Script/Framworker/Function/Physics/Data/EntityEffectState.cs · EntityEffectState" id="effect">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF4DF;strokeColor=#B99142;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="340" width="740" x="840" y="2350" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;参数 ≠ 累计状态&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;DynamicForceParameters：力、目标速度上限、恢复参数；readonly struct。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;ForceData：参数＋speedStacking＋受力 type；跨帧保存于接收者。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;来源实体只是键，累计速度属于 receiver 的 EffectState。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;本帧相位 4 登记 → 下一帧相位 3 积分（T+1）。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;平台 Delta 只参与位置预测，不作为接触施力速度。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Data/Struct.cs" tooltip="Assets/Script/Framworker/Function/Physics/Data/Struct.cs · ForceData" id="force-data">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF4DF;strokeColor=#B99142;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="315" width="820" x="1640" y="2350" as="geometry" />
          </mxCell>
