              <mxPoint x="1360" y="3020" />
              <mxPoint x="1360" y="3077" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object id="finish" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4.8 · 相位 4 结束&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;projectingArray.Clear；等待下帧重新上报。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;结果留在各实体，不由管理器提交位置。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · ContactForSolution">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry x="40" y="3070" width="500" height="155" as="geometry" />
          </mxCell>
        </object>
        <object id="submit" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;5 · 实体提交一次位置请求&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;MonoPublicMgr → DisplacementCorrection。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;PhysicsWorld.ReadBodyPosition 取 origin，SubmitPosition 提交目标。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;缓存请求步、origin、delta；本相位尚无实际落点。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · DisplacementCorrection">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
            <mxGeometry x="40" y="3300" width="500" height="175" as="geometry" />
          </mxCell>
        </object>
        <object id="world-access" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;K9.4 · IPhysicsWorldAccess2D&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;BasicEntity.PhysicsWorld 的 Unity 查询与提交口。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;相位 1/4：AABB、BoxCast、OverlapBox、OverlapCollider 等查询。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;相位 5：ReadBodyPosition、SubmitPosition；仍使用 Unity 命中、碰撞体和刚体类型。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;与相位 4 的解算策略入口分开，不是跨引擎数据契约。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Interface/IPhysicsWorldAccess2D.cs" tooltip="Assets/Script/Framworker/Function/Physics/Interface/IPhysicsWorldAccess2D.cs · IPhysicsWorldAccess2D">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E6F5F4;strokeColor=#4B9292;strokeWidth=1.5;">
            <mxGeometry x="620" y="3300" width="880" height="185" as="geometry" />
          </mxCell>
        </object>
        <object id="engine" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;默认后端 · UnityPhysicsWorldAccess2D&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;defaultPhysicsScene 查命中；SubmitPosition 调用 MovePosition。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Dynamic 模式下提交只是请求；T+1 相位 1 读位置，形成运行时观测。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;差值可含外部写入；观测不反写解算。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;现有相位 4 最多首轮加两轮环境请求，接触对扫描随实体数平方增长。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/UnityPhysicsWorldAccess2D.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/UnityPhysicsWorldAccess2D.cs · UnityPhysicsWorldAccess2D">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F7F9FC;strokeColor=#B5BFCD;strokeWidth=1.5;">
            <mxGeometry x="1560" y="3300" width="900" height="185" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge-30" value="提交" edge="1" parent="1" source="submit" target="world-access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B9292;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
