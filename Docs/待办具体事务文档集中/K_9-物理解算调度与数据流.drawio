        <object id="force-calc" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;CurrentAabbContactSolver.PlanContactEffects&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;用最终请求和 motionVelocity.x 筛可行闭合接触。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;输出 DirectedContactPlan：source、receiver、力参数、方向及保留率。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;不维护 current/previous 关系，不直接改接收者累计速度。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;管理器决定新关系衰减与退出，再按原顺序应用。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/CurrentAabbContactSolver.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/CurrentAabbContactSolver.cs · PlanContactEffects">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F2EDFA;strokeColor=#9775BB;strokeWidth=1.5;">
