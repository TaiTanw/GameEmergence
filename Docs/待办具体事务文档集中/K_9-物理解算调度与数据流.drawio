        <object id="clear" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4.4 · 收集当帧接触效果决定&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;管理器调用 ContactStrategy.PlanContactEffects，再整理当前/退出关系。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;只读最终请求；决定阶段不改实体效果。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · ApplyContactEffectsAfterFinalRequests">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry x="40" y="2100" width="500" height="160" as="geometry" />
          </mxCell>
        </object>
        <object id="clear-e" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;管理器待应用决定&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;pendingContactPlans 是策略给出的 DirectedContactPlan；管理器换成有向来源与力参数。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;pendingContactForces、pendingAttenuations 与 pendingExitedContactLinks 随后统一应用。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;决定阶段不修改实体状态，不回写本帧请求。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · CollectFeasibleContactForces">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F2EDFA;strokeColor=#9775BB;strokeWidth=1.5;">
            <mxGeometry x="1400" y="2350" width="1060" height="170" as="geometry" />
          </mxCell>
        </object>
