          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="atten" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4.6 · 应用新接触衰减&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;决定期只汇总新关系；同实体同方向取最小保留率，本帧应用一次。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · ApplyPendingAttenuations">
