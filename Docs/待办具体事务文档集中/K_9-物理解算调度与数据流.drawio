            <mxGeometry x="40" y="1050" width="500" height="155" as="geometry" />
          </mxCell>
        </object>
        <object id="first-calc" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;CurrentAabbContactSolver.PlanInitialOffsets&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;读取冻结预测框、EnvImpact，按最小重叠轴与 ContactSlop 分担。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;输出 EntityOffsetDecision 列表；首轮可为 X / Y。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;策略不直接改实体、不登记接触力、不移动刚体。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;管理器逐项调用 AccumulateDisplacementOffset。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/CurrentAabbContactSolver.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/CurrentAabbContactSolver.cs · PlanInitialOffsets">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F2EDFA;strokeColor=#9775BB;strokeWidth=1.5;">
            <mxGeometry x="620" y="1030" width="700" height="235" as="geometry" />
          </mxCell>
        </object>
        <object id="acc" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;AccumulateDisplacementOffset&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;管理器 → A / B：累加本帧实体纠偏。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;只修改 EntitySolutionResult.displacementOffset。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · AccumulateDisplacementOffset">
