          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry x="40" y="1740" width="500" height="180" as="geometry" />
          </mxCell>
        </object>
        <object id="feedback-calc" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;CurrentAabbContactSolver.PlanResidualOffsets&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;用冻结预测框与本轮 RequestedWorldDelta 判断残余水平重叠。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;当前规则只处理可沿 X 分离的接触；受阻一侧权重可归零。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;输出 EntityOffsetDecision；不直接调用实体。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;管理器有新增决定才 ApplyPendingOffsets，再重查环境。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;MaxFeedbackPasses = 2；不保证任意箱链收敛。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/CurrentAabbContactSolver.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/CurrentAabbContactSolver.cs · PlanResidualOffsets">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F2EDFA;strokeColor=#9775BB;strokeWidth=1.5;">
