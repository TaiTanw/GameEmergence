            <mxGeometry x="40" y="1320" width="500" height="215" as="geometry" />
          </mxCell>
        </object>
        <object id="probe" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;ProbeCandidateEnvironment · 管理器直接调用&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;BasicEntity 用基础预测＋累计偏置确定候选终点。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;经 PhysicsWorld 读 AABB、扫路径/终点/脚下，过滤自身和其他实体。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;重填 EntityCandidateGeometry 后调用 RequestSolveStrategy.ResolveCandidate。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · ProbeCandidateEnvironment">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
            <mxGeometry x="1400" y="1300" width="1060" height="205" as="geometry" />
          </mxCell>
        </object>
        <object id="resolve" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:19px&quot;&gt;CurrentEntityRequestSolver.ResolveCandidate&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;消费 EntityEnvironmentSolveInput 与候选命中，写允许 X、额外坡面 Y。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;X 受限时经独立 world 入口重查受限终点脚下。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;零距离接触仍区分向内进入与向外离开。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/CurrentEntityRequestSolver.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/CurrentEntityRequestSolver.cs · ResolveCandidate">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
            <mxGeometry x="1400" y="1560" width="500" height="225" as="geometry" />
          </mxCell>
        </object>
        <object id="slope" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:19px&quot;&gt;CurrentEntityRequestSolver.FindSlopeRise&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;原候选终点查一次；X 被缩短且仍非零时再查。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;筛坡角、上坡方向和单向通行，取有效最大额外抬升。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;这是当前策略私有方法；最高候选受阻时返回零。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/CurrentEntityRequestSolver.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/CurrentEntityRequestSolver.cs · FindSlopeRise">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
            <mxGeometry x="1960" y="1560" width="500" height="225" as="geometry" />
          </mxCell>
        </object>
        <object id="lift" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:19px&quot;&gt;CurrentEntityRequestSolver.HasLiftObstacle&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;有支撑时经 world 检查抬升净空；复用 IsOneWayPassThrough。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;单向通行判断也用于路径与顶面筛选，仍属当前策略。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/CurrentEntityRequestSolver.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/CurrentEntityRequestSolver.cs · HasLiftObstacle">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
            <mxGeometry x="1960" y="1840" width="500" height="155" as="geometry" />
          </mxCell>
