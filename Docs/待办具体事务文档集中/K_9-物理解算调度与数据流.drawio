        <mxCell id="edge-13" edge="1" parent="1" source="relations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="effect" value="同相位应用">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-14" edge="1" parent="1" source="effect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AE8739;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="force-data" value="持有">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;相位 5 · 仅提交请求&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;DisplacementCorrection 只读最后一版 requestedWorldDelta。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;PhysicsWorld.ReadBodyPosition 取 origin，SubmitPosition 提交目标。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;缓存请求步、origin、delta；此时尚无 actualPosition。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;管理器已清空预测列表；解算结果至下帧重置。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · DisplacementCorrection" id="submit">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="215" width="740" x="40" y="2820" as="geometry" />
          </mxCell>
        </object>
        <object id="world" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;运行时 · EntityDisplacementObservation&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;T 相位 5 留待观测 requestStep、origin、requestedWorldDelta。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;自动模拟后，T+1 相位 1 在 GeometricQuery 前经 PhysicsWorld.ReadBodyPosition 取实测。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;ActualWorldDelta = actual - origin；DifferenceFromRequest = actual - 请求目标。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;TryGetLastDisplacementObservation 只读已观测结果；外部位置写入也影响差值。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Data/Struct.cs" tooltip="Assets/Script/Framworker/Function/Physics/Data/Struct.cs · EntityDisplacementObservation">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F7F9FC;strokeColor=#B5BFCD;strokeWidth=1.5;" vertex="1">
            <mxGeometry height="215" width="740" x="840" y="2820" as="geometry" />
