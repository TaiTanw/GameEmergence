          </mxCell>
        </object>
        <object id="force-e" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;receiver.SetOrUpdateDynamicForce&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;ApplyPendingContactForces 调用实体，刷新 ForceData 参数与 apply 类型，保留既有 speedStacking。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;本帧登记参数，下一帧相位 3 才积分。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · SetOrUpdateDynamicForce">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
            <mxGeometry x="1400" y="2580" width="1060" height="160" as="geometry" />
          </mxCell>
        </object>
