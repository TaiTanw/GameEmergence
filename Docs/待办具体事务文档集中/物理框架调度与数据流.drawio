<mxfile host="Electron" compressed="false" pages="3">
  <diagram id="k11-phases" name="01 · 六相位统一原生模拟">
    <mxGraphModel background="#FFFFFF" connect="1" tooltips="1" dy="1640" math="0" grid="1" page="1" pageHeight="1640" guides="1" gridSize="10" fold="1" pageScale="1" shadow="0" arrows="1" dx="1400" pageWidth="1400">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object id="title" label="01 · 六相位统一原生模拟&#xA;2026-10-08 · K11 实现完成，自动回归通过；人工手感与缺陷原场景验收待核。" link="../待办安排.md#k_11框架复杂度降低">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=24;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" height="120" y="30" width="1280" />
          </mxCell>
        </object>
        <object id="phase0" label="0 · 平台／水并同步几何&#xA;平台更新位置与 Delta，水更新范围／水位；主动同步几何后再采样。" link="../../Assets/Script/Framworker/AOTSystem/Mgr/Scheduling/MonoPublicMgr.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F7F9FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="160" height="150" y="195" width="1080" />
          </mxCell>
        </object>
        <object id="phase1" label="1 · 读取事实&#xA;原生接触来自上一步已完成模拟；探针读取支撑／墙，区域读取水等来源。单向平台忽略关系在采样前维护。" link="../../Assets/Script/Framworker/Function/Physics/Component/PlayerOBJ/base/BasePhysicsEntity.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F4F3;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="160" height="150" y="395" width="1080" />
          </mxCell>
        </object>
        <object id="phase2" label="2 · 环境／能力／选中&#xA;核对来源，形成表面、水与墙能力事实；更新选中关系。FSM 仍决定跳跃、墙滑／墙跳、游泳与资源规则。" link="../../Assets/Script/Framworker/Function/Physics/Base/EntityEnvironmentContext.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F3E8;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="160" height="150" y="595" width="1080" />
          </mxCell>
        </object>
        <object id="phase3" label="3 · 合成并写入本步刚体速度&#xA;以刚体实际速度为唯一跨帧基准，消费动作与环境参数；平台、环境贡献与重力各只有一个执行入口。两项命令回读量仅避免重复合成，箱子保留真实受推动量。" link="../../Assets/Script/Framworker/Function/Physics/Component/PlayerOBJ/base/BasicEntity.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F3E8;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="160" height="150" y="795" width="1080" />
          </mxCell>
        </object>
        <object id="phase4" label="4 · 统一模拟一次&#xA;角色与箱子均为 Dynamic／Continuous。Script 模式按固定步长推进一次 Unity Physics2D，自动模拟关闭；实体与地形响应均在此发生，无第二提交队列。" link="../../Assets/Script/Framworker/AOTSystem/Mgr/Scheduling/MonoPublicMgr.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="160" height="170" y="995" width="1080" />
          </mxCell>
        </object>
        <object id="phase5" label="5 · 回读实际运动&#xA;读取本步实际位置与速度，供下一物理步与表现使用；运动命令和模拟结果分别观测，观测不反写决策。" link="../../Assets/Script/Framworker/Function/Physics/Component/PlayerOBJ/base/BasicEntity.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F4F3;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="160" height="150" y="1215" width="1080" />
          </mxCell>
        </object>
        <mxCell value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A789E;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" target="phase1" parent="1" id="phase-edge-0" source="phase0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A789E;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" target="phase2" parent="1" id="phase-edge-1" source="phase1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A789E;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" target="phase3" parent="1" id="phase-edge-2" source="phase2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A789E;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" target="phase4" parent="1" id="phase-edge-3" source="phase3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A789E;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" target="phase5" parent="1" id="phase-edge-4" source="phase4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="scope" label="已退出：预测 AABB、地形请求裁剪、残余回算、阻挡传播、T+1 接触传力、两套求解策略及角色／箱子逐帧 MovePosition。&#xA;保留：主动事实查询、规则时序、环境来源、输入行为、收纳事务。平地 1–3 箱有限自动通过；人工手感与原场景仍待核。" link="../待办安排.md#k_11框架复杂度降低">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF4DF;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" height="150" y="1430" width="1280" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="k11-ownership" name="02 · 数据归属与推拉事务">
    <mxGraphModel background="#FFFFFF" connect="1" tooltips="1" dy="1280" math="0" grid="1" page="1" pageHeight="1280" guides="1" gridSize="10" fold="1" pageScale="1" shadow="0" arrows="1" dx="1400" pageWidth="1400">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object id="title" label="02 · 数据归属与推拉事务&#xA;2026-10-08 · K11 已实现；入口只保留仍有用途的职责。" link="../工程原则.md">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=24;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" height="120" y="30" width="1280" />
          </mxCell>
        </object>
        <object id="input" label="输入与行为&#xA;InputControlMgr 只绑定唯一控制目标；Player / FSM 决定动作、能力与资源，不能写刚体或积分重力。" link="../../Assets/Script/Framworker/Function/Player/Player.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F7F9FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" height="210" y="200" width="610" />
          </mxCell>
        </object>
        <object id="environment" label="环境来源与效果&#xA;EntityEnvironmentContext 持来源关系与当前表面／水事实；EntityEffectState 只持环境与限时命令参数。真实动量归刚体，不保留接触传力、累计速度或来源尾效库。" link="../../Assets/Script/Framworker/Function/Physics/Base/EntityEnvironmentContext.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F3E8;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="730" height="210" y="200" width="610" />
          </mxCell>
        </object>
        <object id="motion" label="实体执行与原生结果&#xA;BasicEntity / CharacterPhysics 在相位 3 合成并写本步速度；相位 4 Unity 统一模拟。实际刚体速度是唯一跨帧运动基准；持续速度／主动 X 回读量仅避免重复合成。" link="../../Assets/Script/Framworker/Function/Physics/Component/PlayerOBJ/base/BasicEntity.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F4F3;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" height="220" y="480" width="610" />
          </mxCell>
        </object>
        <object id="selection" label="选中与水平贴合&#xA;PlayerBoxSelection 拥有选中关系；隔距选中先自动走近。原生滑动关节只约束水平贴合、竖直自由，锚点按刚体位置差转换；跳跃、落边、许可关闭或对象退出解除。" link="../../Assets/Script/Framworker/Function/Player/PlayerBoxSelection.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="730" height="220" y="480" width="610" />
          </mxCell>
        </object>
        <mxCell value="动作意图" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A789E;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" target="motion" parent="1" id="input-motion" source="input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="当前参数" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A789E;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" target="motion" parent="1" id="environment-motion" source="environment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="原生水平约束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A789E;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" target="motion" parent="1" id="selection-motion" source="selection">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="storage" label="箱子状态与收纳&#xA;PhysicalBox 拥有收纳矩形与默认状态。收纳关闭碰撞／运动，取出先核对原位实心占用；成功按 Collider → 参与同步 → 采样恢复。重置入口不代替整关刷新编排。" link="../../Assets/Script/Framworker/Function/Physics/Component/SceneObjects/PhysicalBox.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F3E8;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" height="230" y="780" width="610" />
          </mxCell>
        </object>
        <object id="presentation" label="表现与编辑器观测&#xA;只消费逻辑和实际运动结果，不改速度／位置／来源。Interpolate 与冻结根旋转基线保留；旧镜像求解步骤检查已删除，验证围绕实际行为。" link="F_8-物理编辑器观测拆分.md">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F7F9FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="730" height="230" y="780" width="610" />
          </mxCell>
        </object>
        <mxCell value="相位 5 实际运动" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A789E;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" target="presentation" parent="1" id="motion-observation" source="motion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="rule" label="已确认玩法：未选中普通箱可接触推动；箱子保留真实受推速度。普通箱允许从下方顶起，但关卡不依赖；顶起后侧移／下落正常，不积累旧下落速度。&#xA;任意长链、多箱上坡、抱箱跳跃与完整阶段系统不扩入本轮。" link="../玩法大纲.md">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF4DF;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" height="150" y="1080" width="1280" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="k11-lifecycle" name="03 · 单向平台与暂停恢复">
    <mxGraphModel background="#FFFFFF" connect="1" tooltips="1" dy="1510" math="0" grid="1" page="1" pageHeight="1510" guides="1" gridSize="10" fold="1" pageScale="1" shadow="0" arrows="1" dx="1400" pageWidth="1400">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object id="title" label="03 · 单向平台与暂停恢复&#xA;2026-10-08 · 保留关系与生命周期边界，退出自研地形请求过滤。" link="P_5-玩家逻辑行为扩展.md">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=24;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" height="120" y="30" width="1280" />
          </mxCell>
        </object>
        <object id="drop" label="单向平台操作&#xA;角色向下输入沿现有下平台行为产生请求；相位 1 维护逐个平台的忽略关系。多个平台独立恢复，不用一个总计时器替代。" link="../../Assets/Script/Framworker/Function/Physics/Component/PlayerOBJ/base/BasePhysicsEntity.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F3E8;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="160" height="170" y="210" width="1080" />
          </mxCell>
        </object>
        <object id="ignore" label="事实采样与原生碰撞共用关系&#xA;忽略对同时用于脚下事实过滤与 Physics2D.IgnoreCollision；触碰规则仍主动读取事实，角色停用／销毁恢复忽略对。旧环境请求策略退出。" link="../../Assets/Script/Framworker/Function/Physics/Base/UnityPhysicsWorldAccess2D.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F4F3;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="160" height="170" y="430" width="1080" />
          </mxCell>
        </object>
        <mxCell value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A789E;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" target="ignore" parent="1" id="drop-ignore" source="drop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="participation" label="参与状态&#xA;IsMotionReady：组装就绪；IsMotionPermitted：规则许可；IsMotionParticipating：当前实际参与。IsSupported 只表达箱底几何支撑。simulated 只在状态改变时写入。" link="../../Assets/Script/Framworker/Function/Physics/Component/PlayerOBJ/base/BasicEntity.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F7F9FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="160" height="170" y="670" width="1080" />
          </mxCell>
        </object>
        <object id="pause" label="暂停／收纳／操作退出&#xA;暂停保留实际运动状态并停止参与模拟；操作权限关闭、选中失效与落边解除水平约束。收纳状态归箱子，不写入地图记录。" link="../../Assets/Script/Framworker/Function/Physics/Component/SceneObjects/PhysicalBox.cs">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F3E8;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="160" height="170" y="890" width="1080" />
          </mxCell>
        </object>
        <object id="restore" label="恢复／显式刷新&#xA;恢复先启用 Collider，再同步参与和事实采样；明确重置才清速度并安置位置。Player.RefreshRuntime / PhysicalBox.RestoreDefault 提供窄口，整关轻重刷新仍由未来规则编排。" link="P_5.4-执行编排.md">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F4F3;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="160" height="180" y="1110" width="1080" />
          </mxCell>
        </object>
        <mxCell value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A789E;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" target="pause" parent="1" id="participation-pause" source="participation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A789E;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" target="restore" parent="1" id="pause-restore" source="pause">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="verify" label="自动回归通过：初始化、暂停恢复、地面／墙、单向平台、平地 1–3 箱、水面、收纳、高速薄面及移动缩放箱首次绑定。&#xA;人工手感与 V3/V4/V8/V9/V12 原场景仍待核；有限链通过不代表任意链或多箱上坡。" link="../待办安排.md">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#FFF4DF;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" height="130" y="1360" width="1280" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>